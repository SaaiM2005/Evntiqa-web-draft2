# Copy to .env and fill in. Never commit .env.

ENV=prod

POSTGRES_USER=evntiqa
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=evntiqa

# Optional: only for scripts (curl CSV export). Portal users sign in with email + password.
# openssl rand -hex 32
ADMIN_API_KEY=
# openssl rand -hex 16
IP_HASH_SALT=

# Comma-separated site origins allowed to POST forms
ALLOWED_ORIGINS=https://evntiqa.com,https://www.evntiqa.com

SUBMIT_RATE_LIMIT=5/minute
LOGIN_RATE_LIMIT=5/minute
SESSION_TTL_HOURS=12

# Domain Caddy serves the API on (DNS A record must point at this server)
API_DOMAIN=api.evntiqa.com

BACKUP_KEEP_DAYS=14
